# origemlab-backend — copy to .env.local for local dev
# Load order: .env → .nv → .env.local (see src/env.ts)

## Server
# API port for local dev (Vite proxies /api → :8081)
PORT=8081
# Dev: * or http://localhost:3000
CORS_ALLOW_ORIGIN=*
# Front URL for Stripe redirects and OpenRouter HTTP-Referer
APP_BASE_URL=http://localhost:3000
# Extra front origins (CSV), e.g. CloudFront + Pages
# FRONT_ORIGINS=

## Auth cookies
# AUTH_COOKIE_NAME=origemlab_session
AUTH_COOKIE_SECURE=false

## Supabase (required)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

## Migrations (`pnpm db:migrate`) — Management API, SEM senha do Database
# Crie em: https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=sbp_...
# (opcional se SUPABASE_URL já define o ref)
# SUPABASE_PROJECT_REF=

## AI — OpenRouter (required for chat, field AI, embeddings)
# Get a key at https://openrouter.ai/keys — same key as origemlab-services/.env
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
# Default chat model — Qwen3 30B MoE (cost-benefit: ~\$0.05/M in, ~\$0.19/M out on OpenRouter)
OPENROUTER_CHAT_MODEL=qwen/qwen3-30b-a3b-instruct-2507
OPENROUTER_EMBED_MODEL=baai/bge-m3
EMBED_DIMENSIONS=1024
# OPENROUTER_TIMEOUT_MS=180000
# OPENROUTER_HTTP_REFERER=http://localhost:3000
# OPENROUTER_X_TITLE=OrigemLab

## AI — Ollama (emergency / local only: set AI_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_BASE_URL_LOCAL=http://127.0.0.1:11434
# OLLAMA_PREFER_LOCAL=1
# OLLAMA_MODEL=gemma2:2b
# OLLAMA_FAST_MODEL=
# OLLAMA_TIMEOUT_MS=180000
# OLLAMA_CHAT_TIMEOUT_MS=120000
# OLLAMA_PREFER_FAST=0

## Web search — “Embasar com referências” (at least one if you use that feature)
# TAVILY_API_KEY=
# SERPER_API_KEY=
# WEB_SEARCH_MAX_QUERIES=4
# WEB_SEARCH_MAX_RESULTS=5

## Stripe (optional — checkout / webhook / admin billing)
# AISELFIE_STRIPE_SECRET_KEY=
# AISELFIE_STRIPE_WEBHOOK_SECRET=

## Access control
# false = open beta (all Pro features free for testing). true = enforce Stripe plans.
SUBSCRIPTION_ENFORCE=false
# TRUST_PROXY=false

## Production only (Elastic Beanstalk loads JSON from S3 — not needed locally)
# APP_ENV_LOAD_FROM_S3=true
# APP_ENV_S3_BUCKET=
# APP_ENV_S3_KEY=config/elasticbeanstalk-env.json
# AWS_REGION=us-east-1
